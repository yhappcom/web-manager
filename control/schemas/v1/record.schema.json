{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minttap:web-manager:schema:control-record:v1",
  "title": "MintTap control record specimen",
  "oneOf": [
    { "$ref": "#/$defs/app" },
    { "$ref": "#/$defs/feature" },
    { "$ref": "#/$defs/evidence" },
    { "$ref": "#/$defs/claim" }
  ],
  "$defs": {
    "status": {
      "enum": ["DRAFT", "VERIFIED", "STALE", "BLOCKED", "RETIRED"]
    },
    "base": {
      "type": "object",
      "required": ["schema_version", "record_type", "id", "status", "owner"],
      "properties": {
        "schema_version": { "const": 1 },
        "record_type": { "type": "string" },
        "id": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9:._-]+$"
        },
        "status": { "$ref": "#/$defs/status" },
        "owner": { "type": "string", "minLength": 3 }
      }
    },
    "app": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["record_type", "public_name", "lifecycle"],
          "properties": {
            "record_type": { "const": "app" },
            "public_name": { "type": "string", "minLength": 1 },
            "lifecycle": { "enum": ["PLANNED", "ACTIVE", "RETIRED"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "feature": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["record_type", "app_ref", "name", "feature_state"],
          "properties": {
            "record_type": { "const": "feature" },
            "app_ref": { "type": "string" },
            "name": { "type": "string", "minLength": 1 },
            "feature_state": { "enum": ["PLANNED", "BETA", "SHIPPED", "DEPRECATED", "REMOVED"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "evidence": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["record_type", "evidence_type", "summary"],
          "properties": {
            "record_type": { "const": "evidence" },
            "evidence_type": { "enum": ["RELEASE_OBSERVATION", "TEST_REPORT", "STORE_STATE", "SCREENSHOT", "AUTHORITATIVE_SOURCE"] },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "claim": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["record_type", "app_ref", "claim_mode", "feature_refs", "evidence_refs", "text"],
          "properties": {
            "record_type": { "const": "claim" },
            "app_ref": { "type": "string" },
            "claim_mode": { "enum": ["CURRENT", "ROADMAP"] },
            "feature_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
